# =============================================
# 目标平台： 360 T7 (MT7981)
# =============================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7981=y
CONFIG_TARGET_mediatek_mt7981_DEVICE_360_T7=y

# =============================================
# 全局编译基础选项
# =============================================
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_INCLUDE_CONFIG=y

# =============================================
# BusyBox / 基础工具
# =============================================
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_BLKID=y
CONFIG_BUSYBOX_CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_BUSYBOX_CONFIG_VOLUMEID=y

# =============================================
# 内核基础
# =============================================
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_CGROUP_NET_PRIO=y
CONFIG_KERNEL_CGROUP_NET_CLASSID=y
CONFIG_KERNEL_CGROUP_PIDS=y
CONFIG_KERNEL_CGROUP_SCHED=y
CONFIG_KERNEL_FS_POSIX_ACL=y
CONFIG_KERNEL_NET_CLS_CGROUP=y
CONFIG_KERNEL_NETPRIO_CGROUP=y

# =============================================
# 文件系统：保留 f2fs，移除外置存储文件系统
# =============================================
CONFIG_PACKAGE_kmod-fs-f2fs=y
# exfat / ntfs3 / vfat / automount / usb storage 全部剔除
CONFIG_PACKAGE_kmod-fs-exfat=n
CONFIG_PACKAGE_kmod-fs-ntfs3=n
CONFIG_PACKAGE_kmod-fs-vfat=n
CONFIG_PACKAGE_automount=n

# =============================================
# USB / WWAN / SFP / 外接网卡（全部关闭）
# =============================================
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb-ehci=n
CONFIG_PACKAGE_kmod-usb-ohci=n
CONFIG_PACKAGE_kmod-usb-uhci=n
CONFIG_PACKAGE_kmod-usb-xhci=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-storage-uas=n
CONFIG_PACKAGE_kmod-usb-net=n
CONFIG_PACKAGE_kmod-usb-serial=n
CONFIG_PACKAGE_kmod-usb-serial-wwan=n
CONFIG_PACKAGE_kmod-usb-qmi=n
CONFIG_PACKAGE_kmod-usb-ncm=n
CONFIG_PACKAGE_kmod-usb-modeswitch=n
CONFIG_PACKAGE_kmod-sfp=n
CONFIG_PACKAGE_kmod-sfp-plus=n
CONFIG_PACKAGE_wwan=n
CONFIG_PACKAGE_uqmi=n
CONFIG_PACKAGE_libmbim=n

# =============================================
# 分区、磁盘工具（精简）
# =============================================
CONFIG_PACKAGE_partx-utils=n
CONFIG_PACKAGE_zyxel-bootconfig=n

# =============================================
# curl / openssl / ca
# =============================================
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_ca-certificates=y

# =============================================
# LuCI 核心
# =============================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-zh-cn=y

# =============================================
# 网络组件
# =============================================
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dhcpcd=n
CONFIG_PACKAGE_odhcpd=y
CONFIG_PACKAGE_odhcp6c=y

# =============================================
# 无线驱动（MT7981）
# =============================================
CONFIG_PACKAGE_kmod-mt76=y
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt76-connac=y
CONFIG_PACKAGE_kmod-mt76-usb=n
CONFIG_PACKAGE_kmod-mt76-mt7981=y

# =============================================
# 你保留的应用
# =============================================
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_luci-app-filebrowser=n
CONFIG_PACKAGE_luci-app-gecoosac=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-tcpdump=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wan-mac=n
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-harbor-file=y
CONFIG_PACKAGE_luci-app-vnt2=n

# =============================================
# 中文翻译包
# =============================================
CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-gecoosac-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y
CONFIG_PACKAGE_luci-i18n-harbor-file-zh-cn=y

# =============================================
# 主题（Footstrap）
# =============================================
CONFIG_PACKAGE_luci-theme-footstrap=y
CONFIG_PACKAGE_luci-i18n-footstrap-zh-cn=y

# =============================================
# Vantage（仪表盘）
# =============================================
CONFIG_PACKAGE_luci-app-vantage=y
CONFIG_PACKAGE_luci-i18n-vantage-zh-cn=y

# =============================================
# 其他工具
# =============================================
CONFIG_PACKAGE_mii-mgr=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_mountd=n
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_regs=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-bigdecimal=y
CONFIG_PACKAGE_ruby-date=y
CONFIG_PACKAGE_ruby-digest=y
CONFIG_PACKAGE_ruby-enc=y
CONFIG_PACKAGE_ruby-enum=y
CONFIG_PACKAGE_ruby-erb=y
CONFIG_PACKAGE_ruby-etc=y
CONFIG_PACKAGE_ruby-fiber=y
CONFIG_PACKAGE_ruby-fileutils=y
CONFIG_PACKAGE_ruby-gdbm=y
CONFIG_PACKAGE_ruby-io-console=y
CONFIG_PACKAGE_ruby-json=y
CONFIG_PACKAGE_ruby-minitest=y
CONFIG_PACKAGE_ruby-net=y
CONFIG_PACKAGE_ruby-nkf=y
CONFIG_PACKAGE_ruby-openssl=y
CONFIG_PACKAGE_ruby-optparse=y
CONFIG_PACKAGE_ruby-pathname=y
CONFIG_PACKAGE_ruby-psych=y
CONFIG_PACKAGE_ruby-rake=y
CONFIG_PACKAGE_ruby-rdoc=y
CONFIG_PACKAGE_ruby-rexml=y
CONFIG_PACKAGE_ruby-rss=y
CONFIG_PACKAGE_ruby-sdbm=y
CONFIG_PACKAGE_ruby-shellwords=y
CONFIG_PACKAGE_ruby-stringio=y
CONFIG_PACKAGE_ruby-strscan=y
CONFIG_PACKAGE_ruby-tempfile=y
CONFIG_PACKAGE_ruby-term=y
CONFIG_PACKAGE_ruby-tmpdir=y
CONFIG_PACKAGE_ruby-uri=y
CONFIG_PACKAGE_ruby-webrick=y
CONFIG_PACKAGE_ruby-xmlrpc=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_script-utils=y
CONFIG_PACKAGE_swconfig=y
CONFIG_PACKAGE_switch=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_tc-tiny=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_ucode-mod-dataconv=y
CONFIG_PACKAGE_ucode-mod-digest=y
CONFIG_PACKAGE_ucode-mod-iwinfo=y
CONFIG_PACKAGE_ucode-mod-lua=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_wifi-dats=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_wireless-tools=y
CONFIG_PACKAGE_wwan=n
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_zram-swap=y
