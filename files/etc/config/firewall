#!/bin/sh
# ============================================================
# firewall_vnt2_compile.sh
# 用途：在编译期直接写入 /etc/config/firewall（适用于 image builder / rootfs 阶段）
# 使用：将其作为编译钩子（例如 package/Makefile 的 postinst，
#       或放在 files/etc/uci-defaults/ 下）执行
# ============================================================

# 要追加的 VNT2 防火墙配置（与源配置完全等价）
VNT2_FIREWALL_CFG='

config zone 'vnt2zone'
	option name 'VNT2'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option masq '1'
	option mtu_fix '1'
	option network 'VNT2'

config forwarding 'vnt2fwlan'
	option src 'VNT2'
	option dest 'lan'

config forwarding 'vnt2fwwan'
	option src 'VNT2'
	option dest 'wan'

config forwarding 'lanfwvnt2'
	option src 'lan'
	option dest 'VNT2'
'

FIREWALL_FILE="/etc/config/firewall"

# 若配置已存在则不再重复写入（避免多次编译重复追加）
if grep -q "config zone 'vnt2zone'" "$FIREWALL_FILE" 2>/dev/null; then
    echo "==> VNT2 firewall config already exists, skip."
else
    printf '%s\n' "$VNT2_FIREWALL_CFG" >> "$FIREWALL_FILE"
    echo "==> VNT2 firewall config appended to $FIREWALL_FILE"
fi
